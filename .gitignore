# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# HBN data downloaded from S3. Never commit these: the recordings are large and
# participants.tsv carries participant-level age and CBCL psychopathology
# scores, which must not be redistributed here.
#
# Note the trailing /* rather than a bare directory name. Git does not descend
# into an ignored directory, so a bare "data/" would make the negations below
# silently ineffective and the shipped subject lists would be dropped.
data/*
!data/.gitkeep

# Keep the shipped subject lists. These are subject IDs only, no phenotype data,
# and the pipeline reads them directly.
!data/*_subjects_full_movies.txt
!data/*_subjects_with_labels.txt
!data/all_R1_to_process.txt

# Never commit regenerated lists, only the authoritative shipped copies.
data/*_regen.*

# Pipeline outputs: preprocessed FIF files, ISC tables, tables and figures.
# All are regenerated by the pipeline and none belong in version control.
#
# These are anchored with a leading slash so they match only at the repo root.
# Unanchored "tables/" and "figures/" would also match scripts/tables/ and
# scripts/figures/ and silently drop 17 analysis scripts from the commit.
/outputs/
/tables/
/figures/
/logs/

# Scratch space for the ISC memmap and the Gate 2 ICA cache. Configurable via
# HBN_SCRATCH_ROOT and HBN_GATE2_CACHE; these are the defaults.
/scratch/
